{
  "name": "spotiglass",
  "productName": "SpotiGlass",
  "version": "1.0.0-beta",
  "description": "Desktop Spotify Glassmorphism Widget with Dynamic Characters and Taskbar Dock",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npx electron-builder --win nsis",
    "dist": "npx electron-builder --win portable"
  },
  "keywords": [
    "spotify",
    "electron",
    "widget",
    "glassmorphism",
    "equalizer",
    "spotiglass"
  ],
  "author": "Yastin Vasquez <https://github.com/yastinvasquezzz>",
  "homepage": "https://github.com/yastinvasquezzz",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yastinvasquez.spotiglass",
    "productName": "SpotiGlass",
    "copyright": "Copyright © 2026 Yastin Vasquez",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "auth.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json",
      "*.json",
      "*.png",
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpotiGlass"
    }
  }
}
